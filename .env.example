# Canonical site URL for OG images, sitemap, and JSON-LD (build-time).
# Set both — nuxt-og-image prefers NUXT_SITE_URL over site.url / CF_PAGES_URL.
# Preview: NUXT_PUBLIC_SITE_URL=https://syscraft.tailz.dev
# Preview: NUXT_SITE_URL=https://syscraft.tailz.dev
# After DNS cutover: https://syscraft.dev
NUXT_PUBLIC_SITE_URL=
NUXT_SITE_URL=
